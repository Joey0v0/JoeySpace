# Copy to deploy/.env and fill in the actual value locally.
# For an existing MySQL volume, use its current password.
MYSQL_ROOT_PASSWORD=
# Used by user-rpc and im-rpc; must equal jwt.secret in docker-config.local.yaml while old login issues tokens.
JWT_SECRET=
# Must differ from the old im-api app.server_id (currently 1) and from other user-rpc instances.
USER_SNOWFLAKE_NODE_ID=2
# Must differ from the old im-api node (1), user-rpc node (2), and other im-rpc instances.
IM_SNOWFLAKE_NODE_ID=3
# Must differ from nodes 1, 2, 3 and from other task-rpc instances.
TASK_SNOWFLAKE_NODE_ID=4
# Must differ from nodes 1, 2, 3, 4 and from other agent-rpc instances.
AGENT_SNOWFLAKE_NODE_ID=5
# Only needed when explicitly starting the agent profile; do not commit real values.
ARK_API_KEY=
ARK_MODEL_ID=

# Only used with docker-compose.bot.yaml; keep private keys outside the repo.
# Leave IM_BOT_CERT_DIR empty until you provision IM cert.pem/key.pem/ca.pem.
IM_BOT_CERT_DIR=
IM_BOT_CODE=task-assistant
IM_BOT_AGENT_DNS_NAME=agent.go-im.internal
IM_BOT_KAFKA_TOPIC=chat_messages
# Separate Agent private directory; never mount the IM private key into Agent.
AGENT_BOT_CERT_DIR=
AGENT_IM_BOT_SERVER_NAME=im.go-im.internal

# Only used with docker-compose.trigger.yaml after migrations 022-026.
# Each directory contains its own cert.pem/key.pem/ca.pem; do not commit keys.
USER_TRIGGER_CERT_DIR=
IM_TRIGGER_CERT_DIR=
IM_TRIGGER_USER_CERT_DIR=
AGENT_TRIGGER_CERT_DIR=

# Only used with docker-compose.team-leave.yaml after migrations 031-033.
# Four distinct private directories; each contains cert.pem/key.pem/ca.pem.
# Keep these keys outside the repo. Do not reuse another service's private key.
USER_LEAVE_CERT_DIR=
IM_LEAVE_CERT_DIR=
USER_PUSH_CERT_DIR=
PUSH_USER_CERT_DIR=
